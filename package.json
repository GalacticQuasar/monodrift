{
  "name": "monodrift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p worker && vite build",
    "api": "wrangler d1 migrations apply monodrift --local && wrangler dev --port 8787",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p worker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
